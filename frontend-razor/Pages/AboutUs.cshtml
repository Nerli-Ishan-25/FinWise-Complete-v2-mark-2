@page
@model FinWise.Razor.Pages.AboutUsModel
@{
    ViewData["Title"] = "About Us";
}

<div class="about-us-page">
  <header class="page-header">
    <div class="page-header-left">
      <div class="eyebrow">Platform</div>
      <h1>About FinWise AI</h1>
    </div>
  </header>

  <div class="grid-2-1">
    <div class="grid-column">
      <section class="card" style="margin-bottom: 24px;">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>
           Our Vision
        </h2>
        <p style="color: var(--text-secondary); font-size: 15px; line-height: 1.7;">
          At FinWise AI, we believe personal finance should be clear, intelligent, and actionable—not confusing, reactive, or buried in spreadsheets. 
          Built by a team of computer science students — Ishan Nerli, Tejas Khandekar, Aarya Mane, and Shreyas Patil — 
          FinWise was created to simplify how people manage money using modern technology and AI.
        </p>
        <br />
        <p style="color: var(--text-secondary); font-size: 15px; line-height: 1.7;">
          Our platform combines budget tracking, net worth monitoring, smart financial insights, and AI-powered analysis into one streamlined experience. 
          Whether you're managing monthly expenses, tracking assets and liabilities, or evaluating financial decisions, FinWise helps users move from guesswork to clarity.
        </p>
      </section>

      <section class="card">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
           What Makes FinWise Different
        </h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px;">
          <div class="stat-card" style="padding: 16px;">
            <div class="stat-label" style="color: var(--green); margin-bottom: 8px;">AI-Driven Insights</div>
            <div class="stat-sub">Smarter recommendations, not just static charts</div>
          </div>
          <div class="stat-card" style="padding: 16px;">
            <div class="stat-label" style="color: var(--blue); margin-bottom: 8px;">Complete View</div>
            <div class="stat-sub">Expenses, budgets, assets, and liabilities in one place</div>
          </div>
          <div class="stat-card" style="padding: 16px;">
            <div class="stat-label" style="color: var(--purple); margin-bottom: 8px;">Modern Tech</div>
            <div class="stat-sub">Built using ASP.NET Core, C#, FastAPI, and XGBoost</div>
          </div>
          <div class="stat-card" style="padding: 16px;">
            <div class="stat-label" style="color: var(--amber); margin-bottom: 8px;">User Focused</div>
            <div class="stat-sub">Fast, responsive, and easy to use design</div>
          </div>
        </div>
      </section>
    </div>

    <div class="grid-column">
      <section class="card" style="margin-bottom: 24px;">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
           Our Mission
        </h2>
        <p style="color: var(--text-secondary); font-style: italic; font-size: 14px;">
          "To make wealth management and financial awareness accessible to everyone through intelligent software."
        </p>
      </section>

      <section class="card">
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
           Our Team
        </h2>
        <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
          Created by passionate developers and problem-solvers:
        </p>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          
          <div style="display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(255,255,255,0.03); border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--green-dim); display: flex; align-items: center; justify-content: center; color: var(--green); font-weight: bold; font-size: 12px;">
              IN
            </div>
            <span style="font-weight: 500; color: var(--text-primary);">Ishan Nerli</span>
          </div>

          <div style="display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(255,255,255,0.03); border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--green-dim); display: flex; align-items: center; justify-content: center; color: var(--green); font-weight: bold; font-size: 12px;">
              TK
            </div>
            <span style="font-weight: 500; color: var(--text-primary);">Tejas Khandekar</span>
          </div>

          <div style="display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(255,255,255,0.03); border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--green-dim); display: flex; align-items: center; justify-content: center; color: var(--green); font-weight: bold; font-size: 12px;">
              AM
            </div>
            <span style="font-weight: 500; color: var(--text-primary);">Aarya Mane</span>
          </div>

          <div style="display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(255,255,255,0.03); border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--green-dim); display: flex; align-items: center; justify-content: center; color: var(--green); font-weight: bold; font-size: 12px;">
              SP
            </div>
            <span style="font-weight: 500; color: var(--text-primary);">Shreyas Patil</span>
          </div>

        </div>
      </section>
    </div>
  </div>
</div>
