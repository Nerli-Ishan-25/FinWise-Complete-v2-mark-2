@page
@model FinWise.Razor.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div>
    <div class="page-header">
        <div class="page-header-left">
            <h1>Financial Overview</h1>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Net Worth</span>
                <div class="stat-icon" style="background: rgba(0,230,118,0.1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00e676" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                </div>
            </div>
            <div class="stat-value">$0.00</div>
            <div class="stat-change up">+$0.00 this month</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Monthly Income</span>
                <div class="stat-icon" style="background: rgba(68,138,255,0.1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#448aff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
            </div>
            <div class="stat-value">$0.00</div>
            <div class="stat-sub">This month's income</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Monthly Expenses</span>
                <div class="stat-icon" style="background: rgba(255,82,82,0.1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ff5252" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </div>
            </div>
            <div class="stat-value">$0.00</div>
            <div class="stat-change down">0% of income</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Savings Rate</span>
                <div class="stat-icon" style="background: rgba(255,171,64,0.1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffab40" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2"/><path d="M2 9.1C1.2 9.5 1 10.2 1 11c0 .6.4 2.1 2 2.1"/></svg>
                </div>
            </div>
            <div class="stat-value">0.0%</div>
            <div class="stat-change up">$0.00 saved</div>
        </div>
    </div>

    <!-- Row 1: Cash Flow + Spending Split -->
    <div class="grid-2-1" style="margin-bottom: 20px">
        <div class="chart-card">
            <div class="chart-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                Monthly Cash Flow
            </div>
            <div style="position:relative;height:200px"><canvas id="cashFlowChart"></canvas></div>
            <div style="text-align:center;font-size:12px;color:var(--text-secondary);margin-top:8px">Add transactions to see your cash flow</div>
        </div>

        <div class="chart-card">
            <div class="chart-title"><span style="color:#b388ff">◈</span> Spending Split</div>
            <div style="position:relative;height:160px"><canvas id="spendingChart"></canvas></div>
            <div style="text-align:center;font-size:12px;color:var(--text-secondary);margin-top:8px">No expenses recorded yet</div>
        </div>
    </div>

    <!-- Row 2: Net Worth Growth + Recent Transactions -->
    <div class="grid-2-1">
        <div class="chart-card">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
                <div class="chart-title" style="margin-bottom:0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                    Net Worth Growth
                </div>
                <a href="/NetWorth" class="view-all">Details ›</a>
            </div>
            <div style="display:flex;gap:28px;margin-bottom:16px">
                <div>
                    <div style="font-size:11px;font-weight:700;color:var(--text-secondary)">Assets</div>
                    <div style="font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--green)">$0.00</div>
                </div>
                <div>
                    <div style="font-size:11px;font-weight:700;color:var(--text-secondary)">Debt</div>
                    <div style="font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--red)">$0.00</div>
                </div>
                <div>
                    <div style="font-size:11px;font-weight:700;color:var(--text-secondary)">Net Worth</div>
                    <div style="font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--text-primary)">$0.00</div>
                </div>
            </div>
            <div style="position:relative;height:150px"><canvas id="netWorthChart"></canvas></div>
            <div style="text-align:center;font-size:12px;color:var(--text-secondary);margin-top:8px">Add assets to see net worth growth</div>
        </div>

        <div class="chart-card">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px">
                <div class="chart-title" style="margin-bottom:0">🧾 Recent Transactions</div>
                <a href="/Expenses" class="view-all">View All ›</a>
            </div>
            <div class="empty" style="padding:20px 0">No transactions yet</div>
            <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:12px">
                + Add Transaction
            </button>
        </div>
    </div>
</div>

<!-- Floating Assistant Button -->
<a href="/Assistant" class="assistant-fab" title="AI Assistant">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
</a>

@section Scripts {
<script>
    // Cash Flow Chart
    const cfCtx = document.getElementById('cashFlowChart')?.getContext('2d');
    if (cfCtx) {
        new Chart(cfCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [
                    {
                        label: 'Income',
                        data: [0, 0, 0, 0, 0, 0],
                        borderColor: '#00e676',
                        backgroundColor: 'rgba(0,230,118,0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointRadius: 0
                    },
                    {
                        label: 'Expenses',
                        data: [0, 0, 0, 0, 0, 0],
                        borderColor: '#ff5252',
                        backgroundColor: 'rgba(255,82,82,0.08)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#8899b4', font: { size: 11 } } },
                    y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#8899b4', font: { size: 11 } } }
                }
            }
        });
    }

    // Spending Split Doughnut
    const spCtx = document.getElementById('spendingChart')?.getContext('2d');
    if (spCtx) {
        new Chart(spCtx, {
            type: 'doughnut',
            data: {
                labels: ['No Data'],
                datasets: [{
                    data: [1],
                    backgroundColor: ['rgba(255,255,255,0.06)'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: { legend: { display: false } }
            }
        });
    }

    // Net Worth Line Chart
    const nwCtx = document.getElementById('netWorthChart')?.getContext('2d');
    if (nwCtx) {
        new Chart(nwCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Net Worth',
                    data: [0, 0, 0, 0, 0, 0],
                    borderColor: '#00e676',
                    backgroundColor: 'rgba(0,230,118,0.08)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 2.5,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#8899b4', font: { size: 11 } } },
                    y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#8899b4', font: { size: 11 } } }
                }
            }
        });
    }
</script>
}
