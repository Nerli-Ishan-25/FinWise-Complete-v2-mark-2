@page
@model FinWise.Razor.Pages.AssistantModel
@{
    ViewData["Title"] = "AI Assistant";
}

<style>
    .chat-container { display:flex;flex-direction:column;height:calc(100vh - 120px);max-height:800px; }
    .chat-header { display:flex;align-items:center;gap:12px;padding:12px 0;margin-bottom:8px; }
    .chat-header .session-pills { display:flex;gap:8px; }
    .chat-header .session-pill { padding:6px 14px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--border-light);background:transparent;color:var(--text-secondary);font-family:var(--font-body);transition:all 0.15s; }
    .chat-header .session-pill:hover { color:var(--text-primary); }
    .chat-header .session-pill.active { background:var(--green-dim);color:var(--green);border-color:rgba(0,230,118,0.3); }
    .chat-messages { flex:1;overflow-y:auto;padding:16px 0;display:flex;flex-direction:column;gap:16px; }
    .chat-messages::-webkit-scrollbar { width:4px; }
    .chat-messages::-webkit-scrollbar-thumb { background:var(--border-light);border-radius:4px; }
    .msg { display:flex;gap:10px;max-width:80%; }
    .msg.user { align-self:flex-end;flex-direction:row-reverse; }
    .msg-avatar { width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0; }
    .msg-avatar.ai { background:var(--green-dim);color:var(--green); }
    .msg-avatar.human { background:rgba(255,255,255,0.08);color:var(--text-secondary); }
    .msg-bubble { padding:14px 18px;border-radius:var(--radius);font-size:13px;line-height:1.7; }
    .msg-bubble.ai { background:var(--bg-card);border:1px solid var(--border);color:var(--text-primary); }
    .msg-bubble.user { background:var(--bg-input);border:1px solid var(--border-light);color:var(--text-primary); }
    .msg-bubble .warn-pill { display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;margin-top:10px; }
    .msg-bubble .warn-pill.amber { background:rgba(255,171,64,0.1);border:1px solid rgba(255,171,64,0.25);color:var(--amber); }
    .msg-bubble .warn-pill.green { background:var(--green-dim);border:1px solid rgba(0,230,118,0.2);color:var(--green); }
    .chat-input-wrap { padding:14px 0 0;border-top:1px solid var(--border);display:flex;align-items:center;gap:10px; }
    .chat-input-wrap input { flex:1;background:var(--bg-input);border:1px solid var(--border-light);border-radius:var(--radius);padding:12px 16px;font-family:var(--font-body);font-size:14px;color:var(--text-primary);outline:none; }
    .chat-input-wrap input:focus { border-color:var(--green); }
    .chat-input-wrap input::placeholder { color:var(--text-muted); }
    .chat-send-btn { width:36px;height:36px;border-radius:10px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.18s; }
    .chat-send-btn.attach { background:var(--green-dim);color:var(--green); }
    .chat-send-btn.send { background:rgba(255,255,255,0.06);color:var(--text-secondary); }
    .chat-send-btn.send:hover { background:var(--green);color:#0a0f1a; }
    .chat-hint { font-size:11px;color:var(--text-muted);margin-top:6px; }
    .chat-hint kbd { background:rgba(255,255,255,0.06);padding:2px 6px;border-radius:4px;font-size:10px;border:1px solid var(--border); }
    .msg-bubble p:last-child { margin-bottom:0; }
    .msg-bubble ul, .msg-bubble ol { margin:6px 0;padding-left:18px; }
    .msg-bubble li { margin-bottom:4px; }
    .msg-bubble pre { background:var(--bg-input);padding:10px 14px;border-radius:var(--radius-sm);overflow-x:auto;font-size:12px; }
    .msg-bubble table { border-collapse:collapse;width:100%;margin:8px 0; }
    .msg-bubble th, .msg-bubble td { border:1px solid var(--border);padding:6px 10px;font-size:12px; }
    .msg-bubble th { background:var(--bg-input);font-weight:600; }
</style>

<!-- Quick Action Pills -->
<div class="chat-header">
    <div style="font-size:11px;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.08em;font-weight:600">Sessions</div>
    <div class="session-pills">
        <button class="session-pill active" onclick="quickSend('Monthly Summary')">✦ Monthly Summary</button>
        <button class="session-pill" onclick="quickSend('Budget Suggestions')">💡 Budget Suggestions</button>
        <button class="session-pill" onclick="quickSend('Spending Anomalies')">⚡ Spending Anomalies</button>
    </div>
</div>

<div class="chat-container">
    <!-- Messages Area -->
    <div class="chat-messages" id="chatBox">
        <!-- Welcome Message -->
        <div class="msg">
            <div class="msg-avatar ai">🤖</div>
            <div class="msg-bubble ai">
                <p>Hello! I'm your <strong>FinWise AI Assistant</strong>. I have secure access to your financial profile. How can I help you today?</p>
            </div>
        </div>
    </div>

    <!-- Input Area -->
    <div class="chat-input-wrap">
        <form id="chatForm" style="display:contents">
            <input type="text" id="chatInput" placeholder="Ask about your finances.." autocomplete="off" required />
            <button type="button" class="chat-send-btn attach">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            </button>
            <button type="submit" class="chat-send-btn send">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
        </form>
    </div>
    <div class="chat-hint">
        <kbd>Enter</kbd> to send · <kbd>Shift+Enter</kbd> for new line
    </div>
</div>

<!-- Floating Assistant Button -->
<a href="/Assistant" class="assistant-fab" title="AI Assistant" style="display:none">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
</a>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    const chatBox = document.getElementById('chatBox');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    let history = [];

    function appendMessage(role, text) {
        const isUser = role === 'user';
        const wrapper = document.createElement('div');
        wrapper.className = `msg ${isUser ? 'user' : ''}`;

        const avatarHTML = isUser
            ? `<div class="msg-avatar human"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>`
            : `<div class="msg-avatar ai">🤖</div>`;

        const contentHTML = isUser
            ? text.replace(/</g, "&lt;").replace(/>/g, "&gt;")
            : marked.parse(text);

        wrapper.innerHTML = `${avatarHTML}<div class="msg-bubble ${isUser ? 'user' : 'ai'}">${contentHTML}</div>`;
        chatBox.appendChild(wrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function appendLoading() {
        const wrapper = document.createElement('div');
        wrapper.id = 'loadingMsg';
        wrapper.className = 'msg';
        wrapper.innerHTML = `
            <div class="msg-avatar ai">🤖</div>
            <div class="msg-bubble ai" style="display:flex;align-items:center;gap:8px;color:var(--text-secondary)">
                <span class="dot" style="background:var(--green);animation:pulse 1s infinite"></span> Thinking...
            </div>`;
        chatBox.appendChild(wrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function removeLoading() {
        const el = document.getElementById('loadingMsg');
        if (el) el.remove();
    }

    function quickSend(topic) {
        chatInput.value = topic;
        chatForm.dispatchEvent(new Event('submit'));
    }

    chatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = chatInput.value.trim();
        if (!msg) return;

        appendMessage('user', msg);
        chatInput.value = '';
        chatInput.disabled = true;
        appendLoading();

        try {
            const response = await fetch('?handler=SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, history: history })
            });
            removeLoading();
            if (response.ok) {
                const data = await response.json();
                history.push({ role: 'user', content: msg });
                history.push({ role: 'assistant', content: data.reply });
                appendMessage('assistant', data.reply);
            } else {
                appendMessage('assistant', "⚠️ Sorry, I encountered an error. Please try again.");
            }
        } catch (err) {
            removeLoading();
            appendMessage('assistant', "⚠️ Network error. Please check your connection.");
        } finally {
            chatInput.disabled = false;
            chatInput.focus();
        }
    });
</script>
}
