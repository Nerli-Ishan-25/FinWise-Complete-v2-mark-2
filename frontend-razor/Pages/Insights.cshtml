@page
@model FinWise.Razor.Pages.InsightsModel
@{
    ViewData["Title"] = "Insights";
}

<div>
  <div class="page-header">
    <div class="page-header-left">
      <div class="eyebrow">AI-powered analysis</div>
      <h1>Financial Insights</h1>
    </div>
  </div>

  <div class="grid-2">
    <!-- Health Score -->
    <div class="chart-card">
      <div class="chart-title">◎ Financial Health Score</div>
      <div style="position:relative; text-align:center; margin:10px 0 24px">
        <svg width="200" height="120" viewBox="0 0 200 120" style="overflow:visible">
          <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="14" stroke-linecap="round"/>
          <path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="#00e676" stroke-width="14" stroke-linecap="round"
            stroke-dasharray="195 251"
            style="filter:drop-shadow(0 0 8px rgba(0,230,118,0.5))"/>
        </svg>
        <div style="position:absolute; bottom:0; left:50%; transform:translateX(-50%)">
          <div class="score-number">78</div>
          <div class="score-label">out of 100</div>
          <div class="score-sublabel">Good progress!</div>
        </div>
      </div>

      <div class="metric-row">
        <div class="metric-top">
          <span class="metric-name">Savings Rate</span>
          <span class="metric-score">85/100</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-bar" style="width: 85%; background: #00e676"></div>
        </div>
        <div class="metric-sub">33% — Excellent</div>
      </div>

      <div class="metric-row">
        <div class="metric-top">
          <span class="metric-name">Debt Ratio</span>
          <span class="metric-score">62/100</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-bar" style="width: 62%; background: #ffab40"></div>
        </div>
        <div class="metric-sub">DTI 38% — Moderate</div>
      </div>

      <div class="metric-row">
        <div class="metric-top">
          <span class="metric-name">Emergency Fund</span>
          <span class="metric-score">70/100</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-bar" style="width: 70%; background: #ffab40"></div>
        </div>
        <div class="metric-sub">3.2 months covered</div>
      </div>
      
      <div style="margin-top:16px">
        <div style="font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:10px; text-transform:uppercase; letter-spacing:0.06em">AI Recommendations</div>
        <div style="background:var(--bg-input); border-radius:8px; padding:10px 12px; margin-bottom:8px; font-size:12px; color:var(--text-secondary); border-left:2px solid var(--green)">
          Try to reduce dining out to boost your savings rate to 40%.
        </div>
      </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:16px">
      <!-- Subscriptions -->
      <div class="chart-card">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px">
          <div class="chart-title" style="margin-bottom:0">🔄 Recurring Expenses</div>
          <div style="font-size:12px">
            <span style="font-family:var(--font-display); font-weight:700">$123.97/mo</span>
            <span style="color:var(--red); margin-left:6px">$1,487.64/yr</span>
          </div>
        </div>

        <div class="sub-item">
          <div class="tx-icon" style="background:rgba(255,255,255,0.05)">📺</div>
          <div class="sub-info">
            <div class="sub-name">Netflix</div>
            <div class="sub-last">Last used: 2 days ago</div>
          </div>
          <div style="text-align:right; margin-right:10px">
            <div class="sub-price">$12.99/mo</div>
          </div>
          <span class="badge badge-green" style="margin-right: 6px">Active</span>
        </div>

        <div class="sub-item">
          <div class="tx-icon" style="background:rgba(255,255,255,0.05)">🎵</div>
          <div class="sub-info">
            <div class="sub-name">Spotify</div>
            <div class="sub-last">Last used: Today</div>
          </div>
          <div style="text-align:right; margin-right:10px">
            <div class="sub-price">$10.00/mo</div>
          </div>
          <span class="badge badge-green" style="margin-right: 6px">Active</span>
        </div>

        <div class="sub-item">
          <div class="tx-icon" style="background:rgba(255,255,255,0.05)">💪</div>
          <div class="sub-info">
            <div class="sub-name" style="text-decoration: line-through; opacity: 0.5">Gym</div>
            <div class="sub-last">Last used: 3 weeks ago</div>
          </div>
          <div style="text-align:right; margin-right:10px">
            <div class="sub-price">$35.00/mo</div>
          </div>
          <span class="badge badge-red" style="margin-right: 6px">Unused</span>
        </div>
        
        <div class="alert-bar danger" style="margin-top:12px; font-size:12px">
          ⚡ Cancel unused subscriptions to save <strong style="margin:0 3px">$35.00/month</strong> ($420.00/year)
        </div>
      </div>

      <!-- Smart Suggestions -->
      <div class="chart-card">
        <div class="chart-title">💡 Smart Suggestions</div>
        
        <div class="suggestion-card">
          <div class="suggestion-icon" style="background:var(--amber-dim)">🔔</div>
          <div>
            <div class="suggestion-title">Subscription Overload<span class="dot" style="background:#ffab40"></span></div>
            <div class="suggestion-body">You're spending $123.97/month on subscriptions.</div>
          </div>
        </div>

        <div class="suggestion-card">
          <div class="suggestion-icon" style="background:var(--blue-dim)">📈</div>
          <div>
            <div class="suggestion-title">Invest Your Surplus<span class="dot" style="background:#448aff"></span></div>
            <div class="suggestion-body">Consider moving surplus savings to a diversified index fund.</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
