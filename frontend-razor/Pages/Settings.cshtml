@page
@model FinWise.Razor.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<div>
  <div class="page-header">
    <div class="page-header-left">
      <div class="eyebrow">Account management</div>
      <h1>Settings</h1>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; gap: 20px; max-width: 600px;">

    <!-- Profile -->
    <div class="chart-card">
      <div class="chart-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Profile
      </div>
      <div class="form-grid">
        <div class="input-group">
          <label>Full Name</label>
          <input class="input-field" value="Ishan Nerli" />
        </div>
        <div class="input-group">
          <label>Email</label>
          <input class="input-field" type="email" value="ishan@example.com" />
        </div>
      </div>
      <div class="form-actions" style="margin-top: 16px;">
        <button class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
          Save Profile
        </button>
      </div>
    </div>

    <!-- Password -->
    <div class="chart-card">
      <div class="chart-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Change Password
      </div>
      <div class="form-grid">
        <div class="input-group span-2">
          <label>Current Password</label>
          <input class="input-field" type="password" value="" />
        </div>
        <div class="input-group">
          <label>New Password <span style="color: var(--text-secondary); font-size: 11px;">(min 8 chars)</span></label>
          <input class="input-field" type="password" value="" />
        </div>
        <div class="input-group">
          <label>Confirm Password</label>
          <input class="input-field" type="password" value="" />
        </div>
      </div>
      <div class="form-actions" style="margin-top: 16px;">
        <button class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Update Password
        </button>
      </div>
    </div>

    <!-- Preferences -->
    <div class="chart-card">
      <div class="chart-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        Preferences
      </div>
      <div class="form-grid">
        <div class="input-group span-2">
          <label>Display Currency</label>
          <select class="input-field">
            <option>USD ($)</option>
            <option>EUR (€)</option>
            <option>GBP (£)</option>
            <option>INR (₹)</option>
            <option>JPY (¥)</option>
            <option>CAD ($)</option>
            <option>AUD ($)</option>
          </select>
        </div>
      </div>
      <div class="form-actions" style="margin-top: 16px;">
        <button class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
          Save Preferences
        </button>
      </div>
    </div>

  </div>
</div>
