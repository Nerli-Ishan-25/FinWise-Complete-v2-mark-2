@page
@model FinWise.Razor.Pages.LoanAnalyzerModel
@{
    ViewData["Title"] = "AI Loan Analyzer";
}

<div class="page-header">
    <div class="page-header-left">
        <div class="eyebrow">XGBoost AI Verification</div>
        <h1>Loan Analyzer</h1>
    </div>
</div>

<div class="grid-2-1">
    <!-- Form Column -->
    <div class="card">
        <form method="post" asp-page-handler="Assess">
            <div class="section-title" style="margin-bottom:18px">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                New Loan Request
            </div>
            <div class="form-grid" style="margin-bottom:20px">
                <div class="input-group">
                    <label>Loan Amount ($)</label>
                    <input asp-for="Input.LoanAmount" type="number" class="input-field" value="200000" required />
                </div>
                <div class="input-group">
                    <label>Interest Rate (%)</label>
                    <input asp-for="Input.InterestRate" type="number" step="0.1" class="input-field" value="7" required />
                </div>
                <div class="input-group">
                    <label>Term (months)</label>
                    <input asp-for="Input.LoanTerm" type="number" class="input-field" value="30" required />
                </div>
                <div class="input-group">
                    <label>Purpose</label>
                    <select asp-for="Input.LoanPurpose" class="input-field">
                        <option value="Home">Home</option>
                        <option value="Auto">Auto</option>
                        <option value="Business">Business</option>
                        <option value="Education">Education</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="section-title" style="margin-bottom:18px">
                <span style="color:var(--green)">✧</span> Applicant Profile
            </div>
            <div class="form-grid" style="margin-bottom:20px">
                <div class="input-group">
                    <label>Age</label>
                    <input asp-for="Input.Age" type="number" class="input-field" value="35" required />
                </div>
                <div class="input-group">
                    <label>Credit Score</label>
                    <input asp-for="Input.CreditScore" type="number" class="input-field" value="680" required />
                </div>
                <div class="input-group">
                    <label>Annual Income ($)</label>
                    <input asp-for="Input.Income" type="number" class="input-field" value="1000000" required />
                </div>
                <div class="input-group">
                    <label>Existing Debt/month ($)</label>
                    <input asp-for="Input.ExistingDebt" type="number" class="input-field" value="8000" required />
                </div>
                <div class="input-group">
                    <label>Open Credit Lines</label>
                    <input asp-for="Input.NumCreditLines" type="number" class="input-field" value="3" required />
                </div>
                <div class="input-group">
                    <label>Months Employed</label>
                    <input asp-for="Input.MonthsEmployed" type="number" class="input-field" value="88" required />
                </div>
                <div class="input-group">
                    <label>Employment</label>
                    <select asp-for="Input.EmploymentType" class="input-field">
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Self-employed">Self-employed</option>
                        <option value="Unemployed">Unemployed</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Education</label>
                    <select asp-for="Input.Education" class="input-field">
                        <option value="High School">High School</option>
                        <option value="Bachelor's">Bachelor's</option>
                        <option value="Master's">Master's</option>
                        <option value="PhD">PhD</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Marital Status</label>
                    <select asp-for="Input.MaritalStatus" class="input-field">
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Divorced">Divorced</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Has Mortgage</label>
                    <select asp-for="Input.HasMortgage" class="input-field">
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Has Dependents</label>
                    <select asp-for="Input.HasDependents" class="input-field">
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Co-Signer</label>
                    <select asp-for="Input.HasCoSigner" class="input-field">
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                Analyze Affordability
            </button>
        </form>
    </div>

    <!-- Results Column -->
    <div>
        @if (Model.Result != null)
        {
            var isEligible = Model.Result.Eligible;
            var riskColor = Model.Result.RiskLevel == "Low" ? "var(--green)" : (Model.Result.RiskLevel == "Medium" ? "var(--amber)" : "var(--red)");

            <div class="card risk-card" style="margin-bottom:20px">
                <div class="section-title" style="justify-content:center">
                    <span style="color:var(--text-secondary)">◉</span> Risk Assessment
                </div>
                <div class="risk-payment" style="color:var(--text-primary)">$@Model.Result.MonthlyPayment.ToString("N2")</div>
                <div class="risk-label">Estimated Monthly Payment</div>
                <div style="margin-bottom:16px">
                    <span class="badge" style="background:@(isEligible ? "var(--green-dim)" : "var(--red-dim)");color:@(isEligible ? "var(--green)" : "var(--red)")">
                        @(isEligible ? "LOW" : "HIGH") DEFAULT RISK (@Model.Result.DefaultProbabilityPct.ToString("0.##")%)
                    </span>
                </div>
                <div class="risk-metrics">
                    <div class="risk-metric">
                        <div class="val" style="color:var(--green)">@Model.Result.DebtToIncomeRatio.ToString("0.#")%</div>
                        <div class="key">Debt-to-Income</div>
                    </div>
                    <div class="risk-metric">
                        <div class="val" style="color:var(--green)">$@Model.Result.TotalInterest.ToString("N0")</div>
                        <div class="key">Total Interest</div>
                    </div>
                </div>
            </div>

            <!-- AI Verdict -->
            <div class="alert-bar" style="flex-direction:column;align-items:flex-start;gap:6px;background:@(isEligible ? "rgba(0,230,118,0.06)" : "var(--red-dim)");border-color:@(isEligible ? "rgba(0,230,118,0.2)" : "rgba(255,82,82,0.25)");color:var(--text-primary)">
                <div style="display:flex;align-items:center;gap:8px">
                    <span class="badge badge-green" style="font-size:9px">AI</span>
                    <strong>Verdict:</strong>
                </div>
                <div style="font-size:12px;color:var(--text-secondary);line-height:1.5">@Model.Result.Explanation</div>
            </div>

            <!-- Key Factors -->
            @if (Model.Result.KeyFactors?.Any() == true)
            {
                <div class="card" style="margin-top:14px">
                    <div class="section-title" style="font-size:13px">Key ML Factors:</div>
                    <ul style="margin:0;padding-left:18px;color:var(--text-secondary);font-size:12px;line-height:2">
                        @foreach (var factor in Model.Result.KeyFactors)
                        {
                            <li>@factor</li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="card" style="text-align:center;padding:60px 20px">
                <div class="section-title" style="justify-content:center;margin-bottom:12px">
                    <span style="color:var(--text-secondary)">◉</span> Risk Assessment
                </div>
                <div style="font-size:40px;margin-bottom:12px;opacity:0.3">🤖</div>
                <div style="color:var(--text-secondary);font-size:13px">Fill out the loan request form and click<br><strong>Analyze Affordability</strong> to get an AI prediction.</div>
            </div>
        }
    </div>
</div>

<!-- Floating Assistant Button -->
<a href="/Assistant" class="assistant-fab" title="AI Assistant">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
</a>
