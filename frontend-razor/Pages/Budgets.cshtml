@page
@model FinWise.Razor.Pages.BudgetsModel
@{
    ViewData["Title"] = "Budget Planner";
}

<div class="page-header">
    <div class="page-header-left">
        <div class="eyebrow">Zero-based budgeting</div>
        <h1>Budget Planner</h1>
    </div>
    <div class="page-header-right">
        <button class="btn btn-primary" onclick="document.getElementById('addBudgetModal').style.display='flex'">+ Add Category</button>
    </div>
</div>

@if (!Model.Budgets.Any())
{
    <div class="alert-bar" style="margin-bottom:20px">
        <span>📋</span>
        <span>Showing sample data — click <strong>+ Add Category</strong> to create your real budget</span>
    </div>
}

<!-- Summary Stats -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px">
    <div class="stat-card" style="text-align:center;padding:18px">
        <div style="font-size:11px;color:var(--text-secondary);margin-bottom:6px">Monthly Income</div>
        <div style="font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--green)">$0</div>
    </div>
    <div class="stat-card" style="text-align:center;padding:18px">
        <div style="font-size:11px;color:var(--text-secondary);margin-bottom:6px">Total Budgeted</div>
        <div style="font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--text-primary)">
            @{var totalBudgeted = Model.Budgets.Sum(b => b.BudgetAmount);}
            @totalBudgeted.ToString("C")
        </div>
    </div>
    <div class="stat-card" style="text-align:center;padding:18px">
        <div style="font-size:11px;color:var(--text-secondary);margin-bottom:6px">Total Spent</div>
        <div style="font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--red)">
            @{var totalSpent = Model.Budgets.Sum(b => b.Spent);}
            @totalSpent.ToString("C")
        </div>
    </div>
    <div class="stat-card" style="text-align:center;padding:18px">
        <div style="font-size:11px;color:var(--text-secondary);margin-bottom:6px">Unallocated</div>
        <div style="font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--amber)">
            @((0 - totalBudgeted).ToString("C"))
        </div>
    </div>
</div>

<!-- Budget Cards Grid -->
<div class="grid-2" style="margin-bottom:20px">
    @foreach (var budget in Model.Budgets.OrderByDescending(b => b.Year).ThenByDescending(b => b.Month))
    {
        var pct = budget.BudgetAmount > 0 ? (budget.Spent / budget.BudgetAmount) * 100 : 0;
        var pctClamped = Math.Min(pct, 100);
        var remaining = budget.BudgetAmount - budget.Spent;
        var barColor = pct > 100 ? "var(--red)" : pct > 75 ? "var(--amber)" : pct > 50 ? "#ffab40" : "var(--blue)";
        var pctColor = pct > 100 ? "var(--red)" : pct > 75 ? "var(--amber)" : "var(--green)";

        <div class="card">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
                <div style="font-family:var(--font-display);font-size:15px;font-weight:700;color:var(--text-primary)">
                    @(budget.CategoryName ?? "Unknown")
                </div>
                <div class="badge" style="background:@(pct > 100 ? "var(--red-dim)" : pct > 75 ? "rgba(255,171,64,0.15)" : "var(--green-dim)");color:@pctColor">
                    @pct.ToString("0")%
                </div>
            </div>
            <div class="progress-wrap" style="margin-bottom:14px">
                <div class="progress-bar" style="width:@pctClamped.ToString("0.#")%;background:@barColor"></div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:12px">
                <span style="color:var(--text-secondary)">Spent: <strong style="color:var(--text-primary)">@budget.Spent.ToString("C")</strong></span>
                <span style="color:var(--text-secondary)">Budget: <strong style="color:var(--text-primary)">@budget.BudgetAmount.ToString("C")</strong></span>
                <span style="color:@(remaining >= 0 ? "var(--green)" : "var(--red)")">@(remaining >= 0 ? remaining.ToString("C") + " left" : "-" + Math.Abs(remaining).ToString("C") + " over")</span>
            </div>
        </div>
    }
</div>

@if (!Model.Budgets.Any())
{
    <div style="text-align:center;padding:40px 0;color:var(--text-secondary)">
        <div style="font-size:32px;margin-bottom:8px">🎯</div>
        <div style="font-size:15px;font-weight:600;margin-bottom:4px">No budgets set yet</div>
        <div style="font-size:13px">Create your first budget to start tracking your spending goals.</div>
    </div>
}

<!-- Add Budget Modal -->
<div class="modal-backdrop" id="addBudgetModal" style="display:none" onclick="if(event.target===this)this.style.display='none'">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">Add Budget Category</div>
            <button class="btn-ghost" onclick="document.getElementById('addBudgetModal').style.display='none'" style="font-size:20px;padding:0">&times;</button>
        </div>
        <form method="post" asp-page-handler="AddBudget">
            <div class="form-grid">
                <div class="input-group span-2">
                    <label>Category</label>
                    <select asp-for="Input.CategoryId" class="input-field" required>
                        <option value="">-- Select Category --</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="input-group span-2">
                    <label>Budget Limit</label>
                    <input asp-for="Input.BudgetAmount" type="number" step="0.01" class="input-field" placeholder="0.00" required />
                </div>
                <div class="input-group">
                    <label>Month</label>
                    <input asp-for="Input.Month" type="number" min="1" max="12" class="input-field" required />
                </div>
                <div class="input-group">
                    <label>Year</label>
                    <input asp-for="Input.Year" type="number" min="2000" class="input-field" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-outline" onclick="document.getElementById('addBudgetModal').style.display='none'">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Budget</button>
            </div>
        </form>
    </div>
</div>

<!-- Floating Assistant Button -->
<a href="/Assistant" class="assistant-fab" title="AI Assistant">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
</a>
